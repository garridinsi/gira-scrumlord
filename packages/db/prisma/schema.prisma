// gira-scrumlord data model — M1.
// SPDX-License-Identifier: GPL-3.0-or-later
//
// Money is ALWAYS integer minor units (cents) + an ISO-4217 currency. Never floats.
// Client users are isolated to their own client's data — enforced in the app layer,
// but the foreign keys here make that scoping cheap and unambiguous.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────── enums ──

enum IssueType {
  task
  bug
  story
  epic
}

/// Ascending urgency. `emergency` is the seam M3's paging hooks onto.
enum Priority {
  low
  medium
  high
  urgent
  emergency
}

enum StatusCategory {
  todo
  in_progress
  done
}

enum UserKind {
  staff
  client
}

enum UserRole {
  admin
  member
  viewer
}

enum BillingMode {
  hourly
  fixed
}

enum RateScope {
  default
  client
  project
  issue
}

enum SprintState {
  future
  active
  closed
}

enum ChannelKind {
  email
  webhook
}

enum ChannelScope {
  global
  project
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum IncidentStatus {
  open
  acked
  resolved
}

enum IntakeKind {
  grafana
  wordpress
  generic
}

/// draft = editable, recomputable. issued = sent, worklogs locked. paid = settled.
/// void = cancelled (frees its worklogs). Money only leaves draft once.
enum InvoiceStatus {
  draft
  issued
  paid
  void
}

/// How a project organizes work: agile `sprints`, or `monthly` calendar periods
/// (the maintenance/retainer case — tracked + billed by the month, no sprints).
enum ProjectCadence {
  sprints
  monthly
}

// ───────────────────────────────────────────────────────────── identity ──

model Client {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  currency  String   @default("EUR") // ISO 4217
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  projects Project[]
  rate     Rate?
  invoices Invoice[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  kind      UserKind @default(staff)
  role      UserRole @default(member)
  clientId  String? // required when kind = client (app-enforced + DB CHECK)
  // RESTRICT, not SetNull: a client must not be deletable while it still has users,
  // because SetNull would silently produce kind=client + clientId=NULL rows that
  // break tenant isolation (a null clientId widens, not scopes, the portal). The
  // clients delete route detaches/blocks first.
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  isActive  Boolean  @default(true)
  // Per-user UI language preference (es | en | both). Drives the i18n layer.
  locale    String   @default("es")
  // Set when an admin (or self) deactivates the account; sessions are revoked in
  // the same transaction so a reactivated user can't resurrect a stale cookie.
  deactivatedAt DateTime?
  // Stamped each time a magic-link sign-in completes — lets admins tell an invited
  // person who never signed in from an active one.
  lastLoginAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities      Identity[]
  sessions        Session[]
  emailChanges    EmailChangeToken[]
  assignedIssues  Issue[]    @relation("IssueAssignee")
  reportedIssues  Issue[]    @relation("IssueReporter")
  comments              Comment[]
  worklogs              Worklog[]
  timers                Timer[]
  auditLogs             AuditLog[]
  acknowledgedIncidents Incident[]
  assignmentRules       AssignmentRule[]

  @@index([clientId])
}

/// OIDC-ready auth binding. Today provider = "magic-link"; a client's IdP plugs
/// in later as provider = "oidc:<issuer>" with no schema change.
model Identity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  subject   String
  email     String
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String // sha256 of the cookie's secret half — raw value never stored
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  // Touched (throttled) on each authenticated request so the account page can
  // show "last active" per device. Null until the first touch after creation.
  lastSeenAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model MagicLinkToken {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique // sha256 of the single-use token
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

/// Verified email change. The token is minted bound to {userId, newEmail} and the
/// link is emailed to the NEW address only — proving control of it before the
/// switch — so this can never be an account-takeover vector. Single-use
/// (consumedAt), short-lived (expiresAt), and rejected up front if newEmail
/// already maps to a user.
model EmailChangeToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail   String
  tokenHash  String    @unique // sha256 of the single-use token
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ────────────────────────────────────────────────────────────── tracker ──

model Project {
  id           String   @id @default(cuid())
  key          String   @unique // e.g. GIRA
  name         String
  description  String        @default("")
  cadence      ProjectCadence @default(sprints)
  // Optional monthly retainer caps (maintenance projects): hours and/or money.
  monthlyBudgetMinutes Int?
  monthlyBudgetCents   Int?
  clientId     String?
  // RESTRICT, not SetNull: SetNull would silently null a project's clientId when its
  // client is deleted, orphaning the project (and all its issues/worklogs) OUT of any
  // tenant scope — a null clientId widens, not scopes, access. The clients-delete route
  // refuses while projects still reference the client. Mirrors the User→Client choice.
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  issueCounter Int           @default(0) // atomic source of PROJ-N keys
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  statuses        Status[]
  labels          Label[]
  sprints         Sprint[]
  issues          Issue[]
  rate            Rate?
  channels        NotificationChannel[]
  intakeSources   IntakeSource[]
  assignmentRules AssignmentRule[]

  @@index([clientId])
}

model Status {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  category  StatusCategory
  order     Int

  issues Issue[]

  @@unique([projectId, name])
  @@index([projectId])
}

model Label {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String  @default("#8b5cf6")

  issues Issue[] @relation("IssueLabels")

  @@unique([projectId, name])
  @@index([projectId])
}

model Sprint {
  id              String      @id @default(cuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  goal            String?
  startDate       DateTime?
  endDate         DateTime?
  state           SprintState @default(future)
  committedPoints Int? // snapshot taken at start
  completedPoints Int? // snapshot taken at close
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  issues Issue[]

  @@index([projectId])
}

model Issue {
  id              String      @id @default(cuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key             String      @unique // PROJ-N
  title           String
  description     String      @default("") // Markdown
  type            IssueType   @default(task)
  priority        Priority    @default(medium)
  statusId        String
  status          Status      @relation(fields: [statusId], references: [id])
  assigneeId      String?
  assignee        User?       @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId      String
  reporter        User        @relation("IssueReporter", fields: [reporterId], references: [id])
  sprintId        String?
  sprint          Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parentId        String?
  parent          Issue?      @relation("IssueChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children        Issue[]     @relation("IssueChildren")
  storyPoints     Int?
  estimateMinutes Int?
  dueAt           DateTime? // optional deadline; drives due/overdue badges
  rank            String // fractional LexoRank for board ordering
  billingMode     BillingMode @default(hourly)
  fixedPriceCents Int? // used when billingMode = fixed
  externalRef     String? // external system id/fingerprint (M4 intake dedup)
  intakeSourceId  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  closedAt        DateTime?
  resolution      String? // D2: how it was resolved — fixed / wontfix / duplicate / cannot-reproduce
  blockedReason   String? // D1: non-null marks the issue Blocked (the reason); null = not blocked

  labels       Label[]        @relation("IssueLabels")
  comments     Comment[]
  worklogs     Worklog[]
  timers       Timer[]
  rate         Rate?
  incidents    Incident[]
  intakeSource IntakeSource?  @relation(fields: [intakeSourceId], references: [id], onDelete: SetNull)

  @@unique([intakeSourceId, externalRef])
  @@index([projectId, statusId])
  @@index([projectId, rank])
  @@index([assigneeId])
  @@index([sprintId])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String // Markdown
  // N1: 'client' = visible in the client portal; 'internal' = staff-only. Default
  // 'client' so existing comments stay visible; the list endpoint hides 'internal'
  // from any client/portal viewer (the load-bearing guard).
  visibility String  @default("client")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
}

// ──────────────────────────────────────────────────────── time & money ──

model Worklog {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  minutes   Int
  note      String   @default("")
  billable  Boolean  @default(true)
  startedAt DateTime? // set when produced by stopping a timer
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  // A worklog belongs to at most one invoice. Set when invoiced; SetNull on
  // invoice delete frees the hours to be re-billed. This is the no-double-bill seam.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([issueId])
  @@index([userId])
  @@index([invoiceId])
  // Hot path: invoice generation + monthly rollup scan the un-invoiced billable pool
  // filtered by loggedAt range inside a SERIALIZABLE tx. Index it to keep that scan
  // (and its serialization-abort window) bounded as worklog history grows.
  @@index([loggedAt])
}

/// A running stopwatch. At most one active timer per user. Stopping writes a Worklog.
model Timer {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())

  @@index([issueId])
}

/// A bill to a client. Lines snapshot the resolved rate at generation time, so a
/// reprinted invoice always shows the money as it was charged — never recomputed.
/// NOTE: this is a NON-FISCAL billing annex, not a legal invoice. Fiscal invoices
/// are issued externally via TicketBAI/Batuz; `externalInvoiceRef` links to that.
model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique // ANX-YYYY-NNNN annex ref, assigned at creation
  externalInvoiceRef String?   // the real TicketBAI fiscal invoice number, recorded by staff
  clientId      String
  // RESTRICT, not Cascade: a non-fiscal billing annex (and its externalInvoiceRef link
  // to a real TicketBAI invoice) is a financial record — deleting a client must NOT
  // silently destroy its issued/paid annexes. The clients-delete route refuses while
  // any invoice still references the client.
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status        InvoiceStatus @default(draft)
  currency      String // ISO 4217, snapshot of the client's currency
  subtotalCents Int           @default(0) // sum of line amounts, frozen
  periodStart   DateTime?
  periodEnd     DateTime?
  notes         String?
  createdById   String?
  createdAt     DateTime      @default(now())
  issuedAt      DateTime?
  paidAt        DateTime?

  lines    InvoiceLine[]
  worklogs Worklog[]

  @@index([clientId])
  @@index([status])
}

/// One line per billed issue. amountCents and hourlyCents are frozen at generation.
model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  issueId     String? // nullable: the issue may be deleted later; key kept for display
  issueKey    String
  description String
  minutes     Int     @default(0)
  hourlyCents Int? // snapshot of the resolved hourly rate; null for fixed-price lines
  amountCents Int

  @@index([invoiceId])
}

/// One row per scope. Resolution at read time: issue → project → client → default.
model Rate {
  id          String    @id @default(cuid())
  scope       RateScope
  clientId    String?   @unique
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?   @unique
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueId     String?   @unique
  issue       Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  hourlyCents Int
  currency    String    @default("EUR")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ──────────────────────────────────────────────── sauron & the outbox ──

/// Append-only. Sauron only watches. Served read-only on port 666.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "issue.move"
  entityType String
  entityId   String
  before     Json?
  after      Json?
  at         DateTime @default(now())

  @@index([entityType, entityId])
  @@index([at])
}

/// Domain events for scrumlord/notifications. The seam M3 paging consumes.
model Outbox {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt])
}

// ───────────────────────────────────── M3: notifications & paging ──

/// Where notifications go. Admin/member-configured.
model NotificationChannel {
  id        String       @id @default(cuid())
  name      String
  kind      ChannelKind
  target    String // email address or webhook URL
  scope     ChannelScope @default(global)
  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events    String[] // event types this channel wants, e.g. ["issue.emergency"]
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  notifications Notification[]

  @@index([projectId])
}

/// A delivery record (audit + retry).
model Notification {
  id         String              @id @default(cuid())
  type       String
  channelId  String
  channel    NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  payload    Json
  status     NotificationStatus  @default(pending)
  attempts   Int                 @default(0)
  error      String?
  sentAt     DateTime?
  incidentId String?
  incident   Incident?           @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now())

  @@index([channelId])
  @@index([status])
}

/// Opened when an issue reaches `emergency`. The pager nudges open incidents
/// until someone acknowledges.
model Incident {
  id               String         @id @default(cuid())
  issueId          String
  issue            Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  status           IncidentStatus @default(open)
  escalationLevel  Int            @default(0)
  lastNotifiedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?          @relation(fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  notifications Notification[]

  @@index([status])
  @@index([issueId])
}

// ───────────────────────────────────── M4: inbound integrations ──

/// An external system allowed to create issues. Authenticated by a hashed token.
model IntakeSource {
  id              String     @id @default(cuid())
  name            String
  kind            IntakeKind
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokenHash       String     @unique // sha256 of the bearer token (shown once on create)
  defaultType     IssueType  @default(bug)
  defaultPriority Priority   @default(high)
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  issues Issue[]

  @@index([projectId])
}

/// First matching rule (by order) auto-assigns a new issue. Null match = wildcard.
model AssignmentRule {
  id            String     @id @default(cuid())
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order         Int        @default(0)
  matchType     IssueType?
  matchPriority Priority?
  matchLabelId  String?
  assigneeId    String
  assignee      User       @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@index([projectId])
}
