# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# env & secrets (never commit — don't leak client info)
.env
.env.*
!.env.example
!deploy/.env.prod.example

# deploy secrets (server-only): real .env, cloudflared tunnel creds + config
deploy/.env
deploy/cloudflared/*.json
deploy/cloudflared/cert.pem
deploy/cloudflared/config.yml

# prisma generated client
packages/db/generated/

# test / coverage
coverage/

# logs & os cruft
*.log
.DS_Store

# editor
.idea/
.vscode/*
!.vscode/extensions.json
.vscode/
docs/

# claude code worktrees / local tool state
.claude/worktrees/

# local verification screenshots (delivered, not versioned)
docs/design/_shots/
