{
  "name": "gira-scrumlord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jira, but rotated — and now it has a master. Self-hostable issue tracking, time & money.",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm run format:check && pnpm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @gira/db migrate",
    "db:seed": "pnpm --filter @gira/db seed",
    "db:reset": "pnpm --filter @gira/db reset",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.6",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "esbuild@<0.25.0": "^0.25.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "@babel/core@<7.29.6": "^7.29.6"
    }
  }
}
