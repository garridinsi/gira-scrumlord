# Copy to .env and adjust. NEVER commit .env (it is gitignored).
# These defaults match docker-compose.yml and work out of the box for local dev.

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=gira
POSTGRES_PASSWORD=gira
POSTGRES_DB=gira
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gira:gira@localhost:5432/gira?schema=public

# ── API (the "core") ────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
# Public URL of the web app — used to build magic-link callback URLs.
APP_URL=http://localhost:5173
# Secret used to sign session cookies. Generate a real one for prod:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-insecure-change-me-please-0000000000000000
# Mark the session cookie Secure. Leave false over plain HTTP (local/compose demo);
# set true when serving over HTTPS (production behind a TLS terminator).
COOKIE_SECURE=false

# ── sauron (the eye) ─────────────────────────────────────────────────────────
# The canonical port. The README is not joking about this one.
SAURON_PORT=666

# ── Email (magic links) → Mailpit in dev ────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="gira-scrumlord <no-reply@gira.local>"
MAILPIT_UI_PORT=8025

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
