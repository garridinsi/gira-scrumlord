# SPDX-License-Identifier: GPL-3.0-or-later
# Copy to deploy/.env (gitignored) on the server and fill in. NEVER commit secrets.

# Strong, unique. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Strong DB password (used by postgres + DATABASE_URL).
POSTGRES_PASSWORD=

# Public URL served by the Cloudflare tunnel.
APP_URL=https://gira.garridinsi.dev

BILLING_TIMEZONE=Europe/Madrid

# Email — Google Workspace SMTP relay, IP-allowlisted (no auth). Allowlist the
# server's egress IP in Admin console → Apps → Google Workspace → Gmail →
# Routing → SMTP relay service. Sends as the MAIL_FROM address.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
MAIL_FROM="gira-scrumlord <noreply@enekogarrido.com>"
# For an AUTHENTICATED relay instead, set these (TLS is then enforced automatically):
# SMTP_USER=
# SMTP_PASS=
